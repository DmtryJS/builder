# hi3516cv6xx_waybeam_generic: rootfs trim for the 16 MB NOR split layout.
#
# waybeam's CV610 backend drives exactly two sensors, and it drives them as
# userspace plugins: /usr/lib/sensors/libsns_imx662.so comes from the waybeam
# package (built out of the waybeam tree) and libsns_imx335.so from
# hisilicon-opensdk (built out of OpenIPC/openhisilicon). Everything else that
# hisilicon-opensdk and hisilicon-osdrv-hi3516cv6xx put in /usr/lib/sensors
# is unreachable here -- the backend has no mode table for any other part and
# falls back to IMX662 with a warning -- so those blobs only cost flash. A
# board with a different sensor needs the majestic hi3516cv6xx_ultimate
# image, not this one.
#
# Do not add libsns_imx662.so or libsns_imx335.so: imx662 is installed by the
# waybeam package and imx335 by hisilicon-opensdk, and this list runs at
# target-finalize, i.e. after both.
/usr/lib/sensors/libsns_gc4023.so
/usr/lib/sensors/libsns_os04d10.so
/usr/lib/sensors/libsns_sc431hai.so
/usr/lib/sensors/libsns_sc4336p.so
/usr/lib/sensors/libsns_sc450ai.so
/usr/lib/sensors/libsns_sc500ai.so
/usr/lib/sensors/libsns_sp2308.so
# The one vendored blob the osdrv package still ships (no V5 source mirror).
/usr/lib/sensors/libsns_imx307.so
#
# The /etc/sensors profiles are majestic's tuning lookup: it picks the .ini
# whose name starts with the detected sensor and passes it to the ISP. The
# waybeam CV610 backend carries its own per-mode tables and reads no .ini or
# .bin from /etc/sensors at all (see general/package/waybeam/waybeam.mk), so
# the whole set is dead weight on this image.
#
# Measured, in case a future build wants majestic next to waybeam: without
# imx335_i2c_5M.ini majestic refuses to start ("No matches for 'imx335_i2c'
# in /etc/sensors directory") even though it finds the .so on its own. This
# image ships no majestic, so the profile stays out.
/etc/sensors/imx335_i2c_5M.ini
/etc/sensors/modes/imx335_1520p.ini
/etc/sensors/modes/imx335_flex.ini
/etc/sensors/modes/imx335_full10.ini
/etc/sensors/sp2308_i2c_1080p.ini
#
# wifibroadcast-ng installs its own IQ payload into /etc/sensors: Sigmastar
# tuning bins for the SigmaStar air units it was written for. Same story as
# above -- nothing on this image opens them (the CV610 backend carries its own
# per-mode tables, and its .bin export path needs libbin.so, which this image
# does not ship), so they are ~450 KB of rootfs for nothing.
/etc/sensors/imx335_infinity6c.bin
/etc/sensors/imx335_infinity6e.bin
/etc/sensors/imx415_infinity6c.bin
/etc/sensors/imx415_infinity6e.bin
